# Server
PORT=5000
JWT_SECRET=your_high_entropy_jwt_secret_64_hex_chars_or_more

# Artwork URL Signing Secret
ARTWORK_URL_SIGNING_SECRET=your_artwork_url_signing_secret_64_hex_chars

# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=art_match
DB_PORT=3307

# API Key
API_KEY=your_google_gemini_api_key

# Backblaze B2
B2_KEY_ID=your_b2_key_id
B2_APPLICATION_KEY=your_b2_application_key
B2_BUCKET=artmatch-public-assets
B2_REGION=us-east-005
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com

# URLs
FRONTEND_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# Financial payout account encryption: 32 random bytes encoded as 64 hex characters.
# Back up this key securely; changing it makes saved destinations unreadable.
PAYOUT_ACCOUNT_ENCRYPTION_KEY=your_64_character_hex_encryption_key_here

# Payout Provider Configuration
# Default to demo locally unless you have real PayMongo credentials and wallet setup.
PAYOUT_PROVIDER=demo
PAYMONGO_PAYOUTS_ENABLED=false
PAYMONGO_TEST_PAYOUT_IMMEDIATE=true
PAYOUT_HOLD_DAYS=0
PAYMONGO_LIVE_PAYOUT_IMMEDIATE=false
PAYMONGO_PROCESSING_FEE_ENABLED=true
PAYMONGO_PROCESSING_FEE_PERCENT=2
PAYMONGO_PROCESSING_FEE_FLAT_PESOS=15
PAYMONGO_PAYOUT_FEE_RESERVE_CENTAVOS=1000

# PayMongo Credentials
PAYMONGO_SECRET_KEY=sk_test_your_secret_key_here
PAYMONGO_PUBLIC_KEY=pk_test_your_public_key_here
PAYMONGO_WEBHOOK_SECRET=whsk_your_webhook_secret_here
PAYMONGO_PAYOUT_WALLET_ID=wallet_your_wallet_id_here

# Live PayMongo Payout Gates
PAYMONGO_LIVE_PAYOUTS_ENABLED=false
PAYMONGO_MARKETPLACE_PAYOUTS_APPROVED=false
