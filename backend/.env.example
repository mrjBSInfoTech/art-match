# Keep existing database, JWT, B2 and buyer PayMongo settings in backend/.env.
# Payout account encryption: generate 32 random bytes encoded as 64 hex chars.
# Back up this key securely; changing it makes saved destinations unreadable.
PAYOUT_ACCOUNT_ENCRYPTION_KEY=

# Explicit provider selection. Demo never calls PayMongo or moves money.
# Leave paymongo for provider integration; missing credentials never select demo.
# For a local presentation set PAYOUT_PROVIDER=demo and NODE_ENV=development.
# NODE_ENV=production with PAYOUT_PROVIDER=demo refuses startup.
PAYOUT_PROVIDER=paymongo

# Actual PayMongo transfers stay disabled until Wallet capability is verified.
# These PayMongo settings are not used by the demo payout provider.
PAYMONGO_PAYOUTS_ENABLED=false
# Existing presentation override: skip the hold after delivery in nonproduction
# demo mode or PayMongo TEST mode only. Production and Live keep seven days.
PAYMONGO_TEST_PAYOUT_IMMEDIATE=true
PAYMONGO_PAYOUT_WALLET_ID=
# Platform-funded outbound fee reserve in centavos; confirm current pricing.
# This is an available-balance guard, not a deduction from seller earnings.
PAYMONGO_PAYOUT_FEE_RESERVE_CENTAVOS=

# Development uses sk_test_ and PayMongo's official simulated destinations.
# Both live gates additionally require actual institution/PayMongo approval.
PAYMONGO_LIVE_PAYOUTS_ENABLED=false
PAYMONGO_MARKETPLACE_PAYOUTS_APPROVED=false
